# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Every key here is read by config()
# (python-decouple): real environment variables win over this file.
# ---------------------------------------------------------------------------

# --- Django core ---
# Generate a real one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-at-least-50-random-characters
DJANGO_DEBUG=False
# Comma-separated. Never '*' with DEBUG=False unless you know the risks.
DJANGO_ALLOWED_HOSTS=edunexus.com,www.edunexus.com,api.edunexus.com,.edunexus.com
# Tenant subdomains resolve <school-slug>.edunexus.com into request.tenant.
TENANT_ROOT_DOMAIN=edunexus.com
TENANT_PLATFORM_HOSTS=edunexus.com,www.edunexus.com,api.edunexus.com,localhost,127.0.0.1,testserver
# Set False when a reverse proxy (nginx/caddy) already redirects to HTTPS.
DJANGO_SSL_REDIRECT=True

# --- Database (PostgreSQL) ---
DB_NAME=school_saas
DB_USER=school_saas
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- CORS / CSRF (comma-separated origins) ---
# Only needed for split deployments; the same-origin Next proxy needs neither.
CORS_ALLOWED_ORIGINS=https://edunexus.com,https://www.edunexus.com
CSRF_TRUSTED_ORIGINS=https://edunexus.com,https://www.edunexus.com,https://*.edunexus.com

# --- Platform super admin (read by `manage.py bootstrap_superadmin`) ---
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@edunexus.com
SUPERADMIN_PASSWORD=change-me-too
